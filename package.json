{
  "name": "mantle-university-tour",
  "version": "0.1.0",
  "description": "Mantle University Tour - smart contract workspace (Hardhat 3 + Foundry)",
  "keywords": [
    "ethereum",
    "solidity",
    "mantle",
    "hardhat",
    "foundry",
    "university-tour"
  ],
  "license": "MIT",
  "author": "Mantle University Tour",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "anvil": "anvil",
    "clean": "hardhat clean && forge clean",
    "compile": "hardhat compile",
    "compile:forge": "forge build",
    "deploy:ignition:testnet": "echo y | hardhat ignition deploy ignition/modules/MantleUSDCDeploy.ts --network mantleTestnet",
    "deploy:forge:testnet": "set -a && . ./.env && set +a && forge script scripts/forge/Deploy.s.sol:Deploy --rpc-url \"$MANTLE_TESTNET_RPC_URL\" --broadcast --legacy --slow",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "lint": "solhint 'src/**/*.sol' && eslint 'scripts/**/*.ts'",
    "lint:sol": "solhint 'src/**/*.sol'",
    "lint:ts": "eslint 'scripts/**/*.ts'",
    "node": "hardhat node",
    "prettier": "prettier --write .",
    "sort-package-json": "sort-package-json package.json",
    "test": "hardhat test",
    "test:forge": "forge test",
    "test:forge:gas": "forge test --gas-report",
    "test:forge:v": "forge test -vvv"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "eth-chainlist": "^0.0.765",
    "ethers": "^6.16.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.11",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^3.1.5",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.5",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.5",
    "@nomicfoundation/hardhat-keystore": "^3.0.9",
    "@nomicfoundation/hardhat-mocha": "^3.0.19",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.8",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.15",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.5",
    "@nomicfoundation/hardhat-typechain": "^3.0.9",
    "@nomicfoundation/hardhat-verify": "^3.0.17",
    "@nomicfoundation/hardhat-viem": "^3.0.7",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.11",
    "@nomicfoundation/ignition-core": "^3.1.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.2",
    "chai": "^5.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "hardhat": "^3.4.5",
    "mocha": "^11.7.5",
    "prettier": "^3.6.1",
    "solhint": "^6.2.1",
    "sort-package-json": "^3.6.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  }
}
